# DailyDictation Studio Environment Configuration Template
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Super Admin Configuration (Seeded on first startup)
ADMIN_EMAIL_ADDRESS=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMeInProduction123!

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_MAILER_CLIENT_ID=your-mailer-client-id.apps.googleusercontent.com
GOOGLE_MAILER_CLIENT_SECRET=your-client-secret
GOOGLE_MAILER_REFRESH_TOKEN=your-refresh-token

# Security & JWT Token (Generate strong 256-bit secret)
JWT_SECRET=your_secure_256bit_jwt_secret_key_here
JWT_EXPIRATION_HOURS=12

# Database Connection (PostgreSQL 16 in Docker, fallback to SQLite for local tests)
DB_PORT=5444
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=dailydictation
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_postgres_password_here@db:5432/dailydictation
LOCAL_DATABASE_URL=sqlite+aiosqlite:///./data/dailydictation.db

# MinIO S3 Object Storage Configuration (Feedback & Bug Report Screenshots)
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=feedback-images

# Groq Speech-to-Text & AI (Whisper-large-v3)
GROQ_API_KEY=gsk_your_groq_api_key_here

